<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Pinboard</AssemblyName>
    <ApplicationIcon>Pinboard.ico</ApplicationIcon>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <Deterministic>true</Deterministic>
    <Version>1.3.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Pinboard for MultiViewer</AssemblyTitle>
    <Product>Pinboard for MultiViewer</Product>
    <Company>Pinboard for MultiViewer</Company>
    <Authors>Pinboard for MultiViewer</Authors>
    <!-- Setup 17 MB, not 52: publish drops runtime parts Pinboard does not use. Microsoft does not support trimming
         Windows Forms apps, so test every feature after a change. COM stays on (taskbar list, shortcuts). -->
    <PublishTrimmed>true</PublishTrimmed>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Personal build (dotnet build -p:Personal=true): Protect can be turned off in Settings. Never ship it. -->
    <DefineConstants Condition="'$(Personal)' == 'true'">$(DefineConstants);PERSONAL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exo 2, the font MultiViewer uses: SIL Open Font License 1.1 (fonts/OFL.txt) -->
    <EmbeddedResource Include="fonts/*.ttf" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
